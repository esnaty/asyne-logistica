{
  "name": "asyne-logistica",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace @asyne/admin",
    "dev:mobile": "npm run dev --workspace @asyne/mobile",
    "dev:api": "npm run dev --workspace @asyne/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
