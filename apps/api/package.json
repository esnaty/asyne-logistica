    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.2",
    "cookie-parser": "^1.4.7",
